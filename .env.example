# Binance API credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
# Binance mode override: auto (follow BOT_MODE), testnet, mainnet
BINANCE_MODE=auto

# KuCoin API credentials (for future)
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET_KEY=your_kucoin_secret_key_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here
# KuCoin mode override: auto (follow BOT_MODE), testnet, mainnet
KUCOIN_MODE=auto
# If KuCoin runs on mainnet, use non-matching test order endpoint for safe adapter checks
KUCOIN_TEST_ORDERS=true

# Bybit API credentials
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
# Bybit mode override: auto (follow BOT_MODE), testnet, mainnet
BYBIT_MODE=auto

# OKX API credentials
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here
# OKX mode override: auto (follow BOT_MODE), testnet, mainnet
OKX_MODE=auto

# Gate.io
GATE_API_KEY=your_gate_api_key_here
GATE_SECRET_KEY=your_gate_secret_key_here
# Gate mode override: auto (follow BOT_MODE), testnet, mainnet
GATE_MODE=auto

# BingX
BINGX_API_KEY=your_bingx_api_key_here
BINGX_SECRET_KEY=your_bingx_secret_key_here
# BingX mode override: auto (follow BOT_MODE), testnet, mainnet
BINGX_MODE=auto
# BingX settlement/balance asset: auto, VST (Virtual USDT), USDT (real)
BINGX_SETTLEMENT_ASSET=auto

# Bitget
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET_KEY=your_bitget_secret_key_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
# Bitget mode override: auto (follow BOT_MODE), testnet, mainnet
BITGET_MODE=auto

MEXC_API_KEY=your_api_key
MEXC_SECRET_KEY=your_secret_key

# Bot settings
BOT_MODE=testnet  # testnet or mainnet
LOG_LEVEL=INFO    # DEBUG, INFO, WARNING, ERROR
MAX_POSITIONS=100

# Risk management
DEFAULT_STOP_LOSS_PERCENT=20  # % to liquidation
DEFAULT_TAKE_PROFIT_PERCENT=20  # % to liquidation

# Telegram dashboard (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Restrict access to your chat ids only (comma-separated), e.g. 123456789,-100987654321
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_UPDATE_INTERVAL_SECONDS=5
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
