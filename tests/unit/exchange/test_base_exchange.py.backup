        validate_leverage(1)
        validate_leverage(10)
        validate_leverage(125)

    def test_validate_leverage_invalid(self, base_exchange):
        """Test validate_leverage with invalid leverage"""
        with pytest.raises(ValueError):
            validate_leverage(0)

        with pytest.raises(ValueError):
            validate_leverage(126)  # Above max

        with pytest.raises(ValueError):
            validate_leverage(-1)

    def test_validate_price_valid(self, base_exchange):
        """Test validate_price with valid prices"""
        validate_price(100.0)
        validate_price(0.0001)
        validate_price(1000000.0)

    def test_validate_price_invalid(self, base_exchange):
        """Test validate_price with invalid prices"""
        with pytest.raises(ValueError):
            validate_price(0)

        with pytest.raises(ValueError):
            validate_price(-100.0)

    def test_validate_order_type_with_price(self, base_exchange):
        """Test validate_order_type_with_price"""
        # LIMIT order must have price
        validate_order_type_with_price(OrderType.LIMIT, 100.0)

        # MARKET order can have None price
        validate_order_type_with_price(OrderType.MARKET, None)

        with pytest.raises(ValueError):
            validate_order_type_with_price(OrderType.LIMIT, None)

    def test_validate_margin_mode(self, base_exchange):
        """Test margin mode validation"""
        # Should not raise for valid modes
        base_exchange._validate_margin_mode("ISOLATED")
        base_exchange._validate_margin_mode("CROSS")

        with pytest.raises(ValueError):
            base_exchange._validate_margin_mode("INVALID")

